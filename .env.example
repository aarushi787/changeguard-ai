# Copy to .env for Docker Compose. Use a URL-safe random database password.
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_secret
SITE_ADDRESS=localhost
APP_ORIGIN=https://localhost
# Temporarily enable only for company onboarding; disable after creating admin.
ALLOW_REGISTRATION=0
# Local Python commands automatically load the root .env file.
# Explicit process/deployment variables take precedence. Tests ignore .env.
# DATABASE_URL=postgresql+psycopg://changeguard:password@localhost:5432/changeguard
# Supabase setup: see SUPABASE.md. Keep credentials server-side only.
# DATABASE_URL_FILE=data/supabase-database-url.txt
# ENVIRONMENT=production
# RUN_WORKER=0
# STORAGE_PATH=data/documents
# For a disk-free cloud pilot, persist private document bytes in PostgreSQL:
# STORAGE_BACKEND=database
# DOCUMENT_STORAGE_LIMIT_MB=200

# Optional local OCR executable; unset means discover on PATH.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
